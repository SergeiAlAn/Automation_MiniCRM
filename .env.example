# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env в git не попадает.

# Путь к JSON-ключу сервисного аккаунта (относительно корня проекта или абсолютный)
GOOGLE_CREDENTIALS_PATH=your-service-account.json

# Google Таблица для генератора отчётов (report_generator.py)
REPORT_SPREADSHEET_ID=your_report_spreadsheet_id

# Google Таблица с показаниями (проверка CRUD в google_sheets.py)
METERS_SPREADSHEET_ID=your_meters_spreadsheet_id
