# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env в git не попадает.

# Путь к JSON-ключу сервисного аккаунта (относительно корня проекта)
GOOGLE_CREDENTIALS_PATH=credentials/your-service-account.json

# Google Таблица для генератора отчётов (google/report_generator.py)
REPORT_SPREADSHEET_ID=your_report_spreadsheet_id

# Google Таблица с показаниями (google/google_sheets.py)
METERS_SPREADSHEET_ID=your_meters_spreadsheet_id

# Google Drive (google/google_drive.py)
GOOGLE_OAUTH_CLIENT_SECRETS_PATH=credentials/your-client-secret.json
GOOGLE_OAUTH_TOKEN_PATH=credentials/token.json
GOOGLE_DRIVE_FOLDER_ID=

# CRM UI → FastAPI
CRM_API_URL=http://127.0.0.1:8000
